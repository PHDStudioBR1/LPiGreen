# Next.js (LPiGreen) — copie para .env.local e ajuste

# --- Conexão Green → CRM + representante + n8n ---
# O browser chama /api/conexao-green/n8n (registra no CRM, atribui representante e encaminha ao n8n).
N8N_WEBHOOK_URL=

# --- Random-service (rotação de representantes: bot / seguros / telecom) ---
RANDOM_SERVICE_URL=http://random-service-api:3000

# --- Seguros → PHD CRM ---
# Padrão seguro: dev. Use "prod" somente quando quiser enviar para produção.
PHDCRM_ENV=dev
PHDCRM_TENANT_SLUG=igreen

# Pode definir uma base única ou separar por ambiente.
# Prefira PHDCRM_DEV_* / PHDCRM_PROD_*; evite PHDCRM_BASE_URL com PHDCRM_ENV=dev.
PHDCRM_DEV_BASE_URL=https://phdcrmdev.546digitalservices.com
PHDCRM_DEV_EMAIL=admin@igreen
PHDCRM_DEV_PASSWORD=

PHDCRM_PROD_BASE_URL=https://phdcrm.546digitalservices.com
PHDCRM_PROD_EMAIL=admin@igreen
PHDCRM_PROD_PASSWORD=

# --- Notificação por e-mail ao representante (todos os funis) ---
# Mesmas variáveis em dev e prod; valores diferentes por ambiente/secret.
NOTIFY_REPRESENTATIVE_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=notificacoes@seudominio.com
MAIL_FROM_NAME=LPiGreen

# --- Analytics (client) ---
# PostHog projeto 522696 — chave pública (phc_...). Host default: https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Pixel Meta da home (energia). Sem valor, a home não carrega Meta Pixel.
# /seguros e /seguro-auto já têm IDs fixos no código.
NEXT_PUBLIC_META_PIXEL_ID_HOME=
